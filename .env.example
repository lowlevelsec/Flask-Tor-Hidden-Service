# Generate a random value with:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Keep false when the onion service reaches this app over HTTP.
# Set true only when the browser-facing connection uses HTTPS.
SESSION_COOKIE_SECURE=false

# Enable only when the browser-facing connection uses HTTPS.
ENABLE_HSTS=false

# Optional overrides. Use absolute paths in production.
# DATABASE_PATH=/var/lib/onion-vault/sql_database.db
# UPLOAD_FOLDER=/var/lib/onion-vault/uploads
